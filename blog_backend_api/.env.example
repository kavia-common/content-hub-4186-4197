# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# MongoDB (provided by blog_database container). The orchestrator will set these in the actual .env.
MONGODB_URL=
MONGODB_DB=blog

# JWT
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

# Admin Credentials (for initial bootstrap login if no user exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=blog-uploads

# Site URL for SEO feeds (used to build absolute URLs in sitemap and RSS)
SITE_URL=http://localhost:3000
